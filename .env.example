# EngajaBR — configure this value as an Environment Variable in Vercel.
ENGAJABR_API_KEY=your_engajabr_api_key_here

# FalaJoe chatbot — server-side only. Configure in Vercel; do not expose with NEXT_PUBLIC_.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional until the final WhatsApp community invite URL is available.
# Example: https://chat.whatsapp.com/XXXXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
